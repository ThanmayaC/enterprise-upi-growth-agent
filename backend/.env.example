# --- Application metadata ---
APP_NAME=Enterprise UPI Growth Intelligence Platform
APP_ENV=development
DEBUG=true

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS ---
# JSON array of allowed origins, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["*"]

# --- PostgreSQL connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=upi_growth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full SQLAlchemy connection string.
# Leave BLANK to auto-assemble it from the POSTGRES_* values above, or set it
# explicitly (e.g. when a managed database provides a ready-made URL).
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=
